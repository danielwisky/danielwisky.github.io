# Este repositório é público: o registry fica fixo no npm público para o
# lockfile não capturar URLs de um registry privado configurado na máquina
# (~/.npmrc). Isso já aconteceu uma vez e colocou 41 URLs de um CodeArtifact
# corporativo no package-lock.json, além de quebrar o Dependabot e o install
# de quem clonasse o projeto.
registry=https://registry.npmjs.org/
